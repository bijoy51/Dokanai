# Optional API keys — app works fully without them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================
# Local Docker Compose (`docker compose up --build`)
# ============================================================
# Copy this file to `.env` and edit the values, or just run with the
# defaults below for a first try. `.env` is gitignored.
#
# ADMIN_SECRET is shared by the ml-backend container (as ADMIN_SECRET)
# and the web container (as ML_ADMIN_SECRET) so the KV store accepts
# requests from the frontend. Both must match.
ADMIN_SECRET=local-dev-secret

# Signs the session cookie. Any non-empty string works locally;
# change before deploying anywhere real.
AUTH_SECRET=local-dev-auth-secret-change-me

# Pilot AI agent (sidebar tab "Pilot"). Without these, the Pilot tab loads
# but every message returns a clear "not configured" error. Other features
# of the app are unaffected.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Stripe payments (sidebar tab "Subscription"). Without STRIPE_SECRET_KEY the
# Subscription page loads but checkout returns a clean "not configured" error;
# no other feature is affected. Use sk_test_/pk_test_ keys for sandbox mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_CURRENCY=bdt          # set to usd if a Stripe account rejects BDT (amounts live in lib/stripe.ts)
